{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HELIOS Benchmark Prompt Label Schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique prompt identifier"
    },
    "prompt": {
      "type": "string",
      "description": "Natural language user input string"
    },
    "category": {
      "type": "string",
      "description": "Target benchmark category ID"
    },
    "difficulty": {
      "type": "string",
      "enum": ["easy", "medium", "hard"],
      "description": "Evaluated complexity level"
    },
    "expected_intent": {
      "type": "string",
      "description": "The exact programmatic action identifier"
    },
    "expected_parameters": {
      "type": "object",
      "description": "Expected structured arguments dictionary"
    },
    "expected_module": {
      "type": "string",
      "description": "Target executor module name"
    },
    "expected_route": {
      "type": "string",
      "enum": ["LOCAL", "CLOUD"],
      "description": "Target execution location"
    },
    "requires_internet": {
      "type": "boolean",
      "description": "Indicates if web access is necessary"
    },
    "privacy_level": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Normalized data sensitivity indicator"
    },
    "complexity_level": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Normalized prompt logical complexity"
    },
    "expected_model_type": {
      "type": "string",
      "description": "Optimal target model candidate name"
    }
  },
  "required": [
    "id",
    "prompt",
    "category",
    "difficulty",
    "expected_intent",
    "expected_route",
    "requires_internet",
    "privacy_level"
  ]
}
