# ── HELIOS Configuration Template ──────────────────────────────────────────

# ── Local LLM (Ollama) ────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3

# ── Cloud LLM (Optional) ──────────────────────────────────────────────────
CLOUD_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ── OpenRouter Cloud LLM (Optional) ───────────────────────────────────────
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# ── LLM Mode ──────────────────────────────────────────────────────────────
# offline = always use local Ollama model (RECOMMENDED)
# online  = always use cloud
# auto    = local first, cloud only for live web queries
LLM_MODE=auto

# ── Razorpay Payment Capability (Sandbox / Test Mode) ───────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=sandbox
MAX_PAYMENT_AMOUNT_INR=10000

# ── Tavily Primary Commerce Web Search Configuration ─────────────────────
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_SEARCH_ENABLED=true
COMMERCE_SEARCH_PROVIDER=tavily

# ── Google Commerce Web Search Configuration (Optional) ───────────────────
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_ENABLED=false
GOOGLE_SEARCH_MODEL=gemini-3.6-flash
GOOGLE_SEARCH_CX=
GOOGLE_SEARCH_REGION=IN
GOOGLE_SEARCH_LANGUAGE=en
GOOGLE_SEARCH_DIAGNOSTIC_ONLY=false

# ── Other Settings ────────────────────────────────────────────────────────
TIMEZONE=Asia/Kolkata
